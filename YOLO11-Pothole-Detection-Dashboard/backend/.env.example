APP_NAME=YOLO11 Pothole Detection API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./storage/pothole_detection.db
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://terminal.local:4173,http://localhost:4176,http://127.0.0.1:4176,http://terminal.local:4176
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
MODEL_PATH=./model/pothole2v_320.onnx
UPLOAD_DIR=./storage/uploads
RESULTS_DIR=./storage/results
LOG_LEVEL=INFO
DETECTION_CONFIDENCE=0.8
POTHOLE_CLASS_ID=0
